{
  "datasets": [
    {
      "name": "kpi",
      "displayName": "kpi",
      "queryLines": [
        "SELECT\n",
        "  (SELECT round(mape, 2) FROM monitoring.forecast_accuracy_daily ORDER BY forecast_date DESC LIMIT 1) AS last_day_mape,\n",
        "  (SELECT round(avg(mape), 2) FROM (SELECT mape FROM monitoring.forecast_accuracy_daily\n",
        "                                   ORDER BY forecast_date DESC LIMIT 7)) AS mape_7d,\n",
        "  (SELECT count(*) FROM monitoring.forecast_accuracy_daily) AS days_reconciled,\n",
        "  (SELECT date_format(max(timestamp_local), 'yyyy-MM-dd') FROM silver.demand_hourly) AS newest_actual_day,\n",
        "  (SELECT date_format(max(to_date(target_ts)), 'yyyy-MM-dd') FROM gold.demand_forecasts) AS newest_forecast_day\n"
      ]
    },
    {
      "name": "tomorrow",
      "displayName": "tomorrow",
      "queryLines": [
        "SELECT target_ts, predicted_m3, model_version, model_family, issued_at, created_at\n",
        "FROM gold.demand_forecasts\n",
        "WHERE to_date(target_ts) = (SELECT max(to_date(target_ts)) FROM gold.demand_forecasts)\n",
        "QUALIFY row_number() OVER (PARTITION BY target_ts ORDER BY created_at DESC) = 1\n"
      ]
    },
    {
      "name": "fc_vs_actual",
      "displayName": "fc vs actual",
      "queryLines": [
        "WITH fc AS (\n",
        "  SELECT target_ts, predicted_m3 FROM gold.demand_forecasts\n",
        "  WHERE target_ts >= (SELECT max(target_ts) - INTERVAL 14 DAYS FROM gold.demand_forecasts)\n",
        "  QUALIFY row_number() OVER (PARTITION BY target_ts ORDER BY issued_at DESC, created_at DESC) = 1\n",
        ")\n",
        "SELECT target_ts AS ts, 'forecast' AS series, predicted_m3 AS m3h FROM fc\n",
        "UNION ALL\n",
        "SELECT timestamp_local AS ts, 'actual' AS series, demand_m3h AS m3h FROM silver.demand_hourly\n",
        "WHERE timestamp_local >= (SELECT min(target_ts) FROM fc)\n"
      ]
    },
    {
      "name": "daily_accuracy",
      "displayName": "daily accuracy",
      "queryLines": [
        "SELECT forecast_date, round(mape, 2) AS mape, round(wape, 2) AS wape, round(bias_pct, 2) AS bias_pct,\n",
        "       round(max_abs_pct_error, 2) AS max_abs_pct_error, CAST(hours_scored AS INT) AS hours_scored\n",
        "FROM monitoring.forecast_accuracy_daily ORDER BY forecast_date DESC\n"
      ]
    },
    {
      "name": "hourly_errors",
      "displayName": "hourly errors",
      "queryLines": [
        "SELECT target_ts, round(predicted_m3, 0) AS predicted_m3, round(actual_m3, 0) AS actual_m3,\n",
        "       round(error_m3, 0) AS error_m3, round(abs_pct_error, 2) AS abs_pct_error, model_version\n",
        "FROM monitoring.forecast_accuracy_hourly ORDER BY target_ts DESC\n"
      ]
    },
    {
      "name": "dq_summary",
      "displayName": "dq summary",
      "queryLines": [
        "SELECT concat(table_name, '.', check_name) AS check, CAST(sum(failed_rows) AS BIGINT) AS failed_rows,\n",
        "       CAST(sum(CASE WHEN passed THEN 0 ELSE 1 END) AS BIGINT) AS failed_runs\n",
        "FROM monitoring.dq_results GROUP BY 1 ORDER BY failed_rows DESC\n"
      ]
    },
    {
      "name": "dq_latest",
      "displayName": "dq latest",
      "queryLines": [
        "SELECT checked_at, table_name, check_name, severity, passed, CAST(failed_rows AS BIGINT) AS failed_rows, detail\n",
        "FROM monitoring.dq_results ORDER BY checked_at DESC, table_name, check_name LIMIT 200\n"
      ]
    },
    {
      "name": "quarantine",
      "displayName": "quarantine",
      "queryLines": [
        "SELECT detected_at, table_name, reason, record_json FROM monitoring.dq_quarantine\n",
        "ORDER BY detected_at DESC LIMIT 200\n"
      ]
    },
    {
      "name": "models",
      "displayName": "models",
      "queryLines": [
        "SELECT trained_at, `trigger`, family, round(mape, 3) AS holdout_mape, round(peak_mape, 3) AS holdout_peak_mape,\n",
        "       selected, promoted, registered_version, champion_version_before, decision\n",
        "FROM monitoring.model_selection ORDER BY trained_at DESC, mape\n"
      ]
    },
    {
      "name": "models_latest",
      "displayName": "models latest",
      "queryLines": [
        "SELECT family, round(mape, 3) AS holdout_mape FROM monitoring.model_selection\n",
        "WHERE trained_at = (SELECT max(trained_at) FROM monitoring.model_selection) ORDER BY mape\n"
      ]
    }
  ],
